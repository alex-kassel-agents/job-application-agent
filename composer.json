{
    "name": "alex-kassel-agents/job-application-agent",
    "description": "JobApplicationAgent library package for Laravel ecosystem.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "package"
    ],
    "authors": [
        {
            "name": "Alexander Macenko",
            "role": "Developer",
            "email": "alexander.macenko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKasselAgents\\JobApplicationAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKasselAgents\\JobApplicationAgent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKasselAgents\\JobApplicationAgent\\JobApplicationAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
